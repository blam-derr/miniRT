# Simple 2x2x2 cube centered at the origin
# Uses quad faces and vertex normals (v//vn syntax)

v -1.0 -1.0 -1.0
v -1.0 -1.0  1.0
v -1.0  1.0 -1.0
v -1.0  1.0  1.0
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v  1.0  1.0 -1.0
v  1.0  1.0  1.0

vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0

f 1//5 3//5 7//5 5//5
f 2//6 4//6 8//6 6//6
f 1//3 2//3 6//3 5//3
f 3//4 4//4 8//4 7//4
f 1//1 3//1 4//1 2//1
f 5//2 7//2 8//2 6//2
